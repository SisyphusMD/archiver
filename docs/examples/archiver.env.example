#########################################################################################
# Archiver configuration, as an env file (Compose `env_file:`, a Kubernetes ConfigMap)    #
#                                                                                       #
# Non-secret settings are environment variables. Secrets are never environment          #
# variables: each is a file, read from <NAME>_FILE or /run/secrets/<name> (lowercase),   #
# and is marked "secret file" below. See the README "Configuration Sources" section.     #
#                                                                                       #
# Requirements:                                                                         #
# - At least one service directory and one storage target                               #
# - The storage_password and rsa_passphrase secret files, and the RSA keypair           #
#########################################################################################

# ------------------ #
# REQUIRED VARIABLES #
# ------------------ #
# Example SERVICE_DIRECTORIES
# Please provide a list of directories on your device to be backed up. Must provide the
#   full paths. Can use * to indicate each individual subdirectory within the parent
#   directory. Each directory will be backed up as an individual duplicacy repository.
# Colon-delimited list (fits a single env var or a YAML block; newlines also accepted). Here
#   /srv/*/ and /mnt/*/ each back up every subdirectory as its own repository, and /home/user/
#   is one repository.
  # SERVICE_DIRECTORIES=/srv/*/:/mnt/*/:/home/user/

# Storage targets must be numbered sequentially, starting with 1, following the naming
#   scheme STORAGE_TARGET_X_OPTION=value, with all options for the same storage
#   using the same X number, as in the below examples. Local, SFTP, BackBlaze B2, and S3 storage
#   targets are currently supported. Require at least one storage target.
#
# NOTE: Storage names should only contain letters, numbers, and underscores. Other characters
#   will be automatically sanitized (e.g., my-storage becomes my_storage).

# Example Local Disk Storage Target
  # STORAGE_TARGET_1_NAME=local # Unique name (letters, numbers, underscores only).
  # STORAGE_TARGET_1_TYPE=local # Currently support local, sftp, b2, and s3. For local, require LOCAL_PATH as below.
  # STORAGE_TARGET_1_LOCAL_PATH=/mnt/backup/storage # Full path to local directory for backups.

# Example SFTP Storage Target
  # STORAGE_TARGET_2_NAME=nas # Unique name (letters, numbers, underscores only).
  # STORAGE_TARGET_2_TYPE=sftp # Currently support local, sftp, b2, and s3. For sftp, require URL, PORT, USER, and PATH as below.
  # STORAGE_TARGET_2_SFTP_URL=192.168.1.1 # The IP address or FQDN of the sftp host.
  # STORAGE_TARGET_2_SFTP_PORT=22 # The sftp port of the sftp host. Default is 22.
  # STORAGE_TARGET_2_SFTP_USER=user # User with sftp privileges on sftp host.
  # STORAGE_TARGET_2_SFTP_PATH=remote/path # Absolute path to remote backup directory. For synology, this starts with the name of the shared folder.

# Example B2 Storage Target
  # STORAGE_TARGET_3_NAME=backblaze # Unique name (letters, numbers, underscores only).
  # STORAGE_TARGET_3_TYPE=b2 # Currently support local, sftp, b2, and s3. For b2, require BUCKETNAME, ID, and KEY as below.
  # STORAGE_TARGET_3_B2_BUCKETNAME=bucketName # BackBlaze bucket name. Must be globally unique.
  # secret file storage_target_3_b2_id: BackBlaze keyID with read/write access to the above bucket.
  # secret file storage_target_3_b2_key: BackBlaze applicationKey with read/write access to the above bucket.

# Example S3 Storage Target
  # STORAGE_TARGET_4_NAME=hetzner # Unique name (letters, numbers, underscores only).
  # STORAGE_TARGET_4_TYPE=s3 # Currently support local, sftp, b2, and s3. For s3, require BUCKETNAME, ENDPOINT, ID, and SECRET as below.
  # STORAGE_TARGET_4_S3_BUCKETNAME=bucketName # S3 bucket name. Must be globally unique.
  # STORAGE_TARGET_4_S3_ENDPOINT=endpoint # S3 endpoint (ex: amazon.com or hel1.your-objectstorage.com).
  # STORAGE_TARGET_4_S3_REGION=none # S3 region (optional, depending on service. ex: us-east-1)
  # secret file storage_target_4_s3_id: S3 Access ID with read/write access to the bucket.
  # secret file storage_target_4_s3_secret: S3 Secret Key with read/write access to the bucket.

# Secrets for all Duplicacy storage targets (files, not environment variables)
  # secret file storage_password: Password for Duplicacy storage (required)
  # secret file rsa_passphrase: Passphrase for RSA private key (required)


# ------------------ #
# OPTIONAL VARIABLES #
# ------------------ #
# Notifications
  # NOTIFICATION_SERVICE= # Currently support 'Pushover' or 'None'
  # secret file pushover_user_key: Pushover user key (not email address), viewable when logged into Pushover dashboard
  # secret file pushover_api_token: Pushover application API token/key
  # secret file apprise_url: an Apprise API notify URL (user:password@ inside it for basic auth), e.g. http://apprise:8000/notify/archiver
  # APPRISE_TAGS= # Optional: "failure=critical,problem=alerts,routine=quiet" sends each kind with that Apprise tag
  # NTFY_URL= # ntfy server and topic, e.g. https://ntfy.sh/my-archiver
  # secret file ntfy_token: ntfy access token, if the topic needs one
  # NOTIFY_ON= # Default "failures". "problems" adds warning signs; "everything" adds backup/maintenance done, pause/resume/stop
  # PUSHOVER_NOTIFY_ON= / APPRISE_NOTIFY_ON= / NTFY_NOTIFY_ON= # Override NOTIFY_ON for one destination

# Maintenance (check + prune — runs on MAINTENANCE_SCHEDULE or 'archiver maintenance',
# never inside a backup run)
  # CHECK_BACKUPS= # Default: "true". Verify each storage (duplicacy check -all -fossils -resurrect).
  #
  # PRUNE_BACKUPS= # Default: "true". Enforce retention on each storage.
  #                    Set to 'false' (with CHECK_BACKUPS="false") if multiple deployments
  #                    share a storage: only ONE should maintain it.
  #
  # PRUNE_KEEP= # Default: "-keep 0:180 -keep 30:30 -keep 7:7 -keep 1:1"
  #                 Retention policy for old revisions. Must be sorted by age (descending).
  #                 Format: -keep n:m means keep 1 snapshot every n days if the snapshot is at least m days old
  #                 Example breakdown:
  #                   -keep 1:1    = Keep 1 backup every 1 day for backups older than 1 day
  #                   -keep 7:7    = Keep 1 backup every 7 days for backups older than 7 days
  #                   -keep 30:30  = Keep 1 backup every 30 days for backups older than 30 days
  #                   -keep 0:180  = Delete all backups older than 180 days
  #                 See: https://forum.duplicacy.com/t/prune-command-details/1005
  #
  # PRUNE_EXHAUSTIVE_FREQUENCY= # Default: "monthly". One of: off, daily, weekly, monthly.
  #                                 How often prune additionally lists every chunk on the
  #                                 storage (-exhaustive) to garbage-collect orphans —
  #                                 expensive on remote storages, and orphans are rare.
  #                                 Force it any time with 'archiver maintenance exhaustive'.

# Performance
  # DUPLICACY_THREADS= # Default: "4". Number of parallel upload/download threads for duplicacy operations.
  # BACKUP_PARALLELISM= # Default: "2". Services backed up at once; "1" backs them up one after another.
  # LOG_FORMAT= # Default: "text". "json" prints docker logs as one JSON object per line (time, level, service, log, msg).
