+package duplicacy
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/context"
+	"google.golang.org/api/drive/v3"
+	"google.golang.org/api/option"
+)
+
+// A shared drive is found by its name or by its ID, the value its URL shows.
+func TestSharedDriveByNameOrID(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case r.URL.Path == "/drives" && strings.Contains(r.URL.Query().Get("q"), "'Backups'"):
+			w.Write([]byte(`{"drives":[{"id":"0AbcDEF","name":"Backups"}]}`))
+		case r.URL.Path == "/drives":
+			w.Write([]byte(`{"drives":[]}`))
+		case r.URL.Path == "/drives/0AbcDEF":
+			w.Write([]byte(`{"id":"0AbcDEF","name":"Backups"}`))
+		default:
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte(`{"error":{"code":404,"message":"Shared drive not found"}}`))
+		}
+	}))
+	defer server.Close()
+	service, err := drive.NewService(context.Background(), option.WithEndpoint(server.URL+"/"), option.WithHTTPClient(server.Client()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for in, want := range map[string]string{"Backups": "0AbcDEF", "0AbcDEF": "0AbcDEF"} {
+		if got, err := resolveSharedDrive(service, in); err != nil || got != want {
+			t.Errorf("%s: got %q, %v; want %q", in, got, err, want)
+		}
+	}
+	if _, err := resolveSharedDrive(service, "nothing"); err == nil {
+		t.Error("an unknown drive was accepted")
+	}
+}
