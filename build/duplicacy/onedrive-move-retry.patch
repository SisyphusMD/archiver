+package duplicacy
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+
+	"golang.org/x/oauth2"
+)
+
+// A move retried after creating its missing destination fails if the retry fails.
+func TestOneDriveMoveFailsWhenTheRetryFails(t *testing.T) {
+	patches := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.Method {
+		case http.MethodPatch:
+			patches++
+			if patches == 1 {
+				w.WriteHeader(http.StatusBadRequest)
+				w.Write([]byte(`{"error":{"code":"invalidRequest","message":"parent missing"}}`))
+				return
+			}
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte(`{"error":{"code":"itemNotFound","message":"item gone"}}`))
+		case http.MethodPost:
+			w.WriteHeader(http.StatusCreated)
+			w.Write([]byte(`{"id":"dir","name":"fossils","folder":{}}`))
+		default:
+			w.WriteHeader(http.StatusMethodNotAllowed)
+		}
+	}))
+	defer server.Close()
+
+	client := &OneDriveClient{
+		HTTPClient: server.Client(),
+		Token:      &oauth2.Token{AccessToken: "token"},
+		TokenLock:  &sync.Mutex{},
+		APIURL:     server.URL,
+	}
+	if err := client.MoveFile("chunks/abcd", "fossils"); err == nil {
+		t.Fatal("got nil, want the failed retry's error")
+	}
+	if patches != 2 {
+		t.Fatalf("got %d PATCH requests, want 2", patches)
+	}
+}
