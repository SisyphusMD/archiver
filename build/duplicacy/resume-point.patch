+// Interrupted twice: the second resume point preserves the files the first attempt finished,
+// with the chunks it uploaded, which belong to no revision.  One of those is deleted, as a
+// prune can do, so the second resume point must not be used either.
+func testResumeTwicePruned(t *testing.T) {
+	setTestingT(t)
+	SetLoggingLevel(INFO)
+	testDir := path.Join(os.TempDir(), "duplicacy_resume_test")
+	os.RemoveAll(testDir)
+	defer os.RemoveAll(testDir)
+	top := testDir + "/repository1"
+	os.MkdirAll(top+"/.duplicacy", 0700)
+	os.MkdirAll(testDir+"/repository2/.duplicacy", 0700)
+	storage, err := loadStorage(testDir+"/storage", 1)
+	if err != nil {
+		t.Fatalf("Failed to create storage: %v", err)
+	}
+	cleanStorage(storage)
+	if !ConfigStorage(storage, 16384, 100, 64*1024, 256*1024, 16*1024, "duplicacy", nil, false, "", 0, 0) {
+		t.Fatal("Failed to initialize the storage")
+	}
+	SetDuplicacyPreferencePath(top + "/.duplicacy")
+	manager := CreateBackupManager("host1", storage, testDir, "duplicacy", "", "", false)
+	manager.SetupSnapshotCache("default")
+	createRandomFile(top+"/old", 500000)
+	manager.Backup(top, true, 1, "first", false, false, 0, false, 1024, 1024)
+	var files []string
+	for i := 0; i < 8; i++ {
+		files = append(files, fmt.Sprintf("new%d", i))
+		createRandomFile(top+"/"+files[i], 1000000)
+	}
+
+	os.Setenv("DUPLICACY_RESUME_INTERVAL", "0")
+	defer os.Unsetenv("DUPLICACY_RESUME_INTERVAL")
+	stopAfter := func(n int, tag string) {
+		saves := 0
+		afterResumePointSaved = func() {
+			saves++
+			if saves == n {
+				panic(stopBackup{})
+			}
+		}
+		defer func() {
+			afterResumePointSaved = func() {}
+			if _, ok := recover().(stopBackup); !ok {
+				t.Fatalf("the %s backup was not stopped at its resume point", tag)
+			}
+		}()
+		manager.Backup(top, true, 1, tag, false, false, 0, false, 1024, 1024)
+	}
+	cachePath := func() string {
+		found := ""
+		filepath.Walk(top+"/.duplicacy", func(p string, info os.FileInfo, err error) error {
+			if err == nil && info.Name() == "incomplete_chunks" {
+				found = filepath.Dir(p)
+			}
+			return nil
+		})
+		return found
+	}
+
+	stopAfter(30, "second")
+	time.Sleep(2 * time.Second)
+	first := loadIncompleteSnapshot("host1", cachePath())
+	if first == nil || len(first.UploadedChunkHashes) == 0 {
+		t.Fatal("the first attempt saved no resume point")
+	}
+	first.CloseOnDiskFile()
+	firstChunk := first.UploadedChunkHashes[0]
+
+	stopAfter(5, "third")
+	time.Sleep(2 * time.Second)
+	second := loadIncompleteSnapshot("host1", cachePath())
+	if second == nil {
+		t.Fatal("the second attempt saved no resume point")
+	}
+	second.CloseOnDiskFile()
+	preserved := false
+	for _, hash := range second.PreservedChunkHashes {
+		preserved = preserved || hash == firstChunk
+	}
+	if !preserved {
+		t.Fatal("the second resume point does not preserve the first attempt's chunk")
+	}
+	chunkPath, exist, _, err := storage.FindChunk(0, manager.config.GetChunkIDFromHash(firstChunk), false)
+	if err != nil || !exist {
+		t.Fatalf("the first attempt's chunk is not on the storage: %v", err)
+	}
+	if err := os.Remove(path.Join(testDir, "storage", chunkPath)); err != nil {
+		t.Fatal(err)
+	}
+
+	discarded := false
+	resumeLog.Lock()
+	resumeLog.handle = func(level int, logID string, message string) {
+		if level > WARN {
+			t.Errorf("%s %s", logID, message)
+		}
+		discarded = discarded || logID == "INCOMPLETE_DISCARD"
+	}
+	resumeLog.Unlock()
+	manager.Backup(top, true, 1, "fourth", false, false, 0, false, 1024, 1024)
+	resumeLog.Lock()
+	resumeLog.handle = nil
+	resumeLog.Unlock()
+	if !discarded {
+		t.Error("a resume point naming a pruned chunk was used")
+	}
+	SetDuplicacyPreferencePath(testDir + "/repository2/.duplicacy")
+	failed := manager.Restore(testDir+"/repository2", 2, true, false, 1, true, false, false, false, nil, false)
+	assertRestoreFailures(t, failed, 0)
+	for _, f := range append(files, "old") {
+		if getFileHash(top+"/"+f) != getFileHash(testDir+"/repository2/"+f) {
+			t.Errorf("%s did not restore byte for byte", f)
+		}
+	}
