+// A backup that stops just after a resume point, as one killed there would, resumes from
+// it: the files it had finished are not read again, and the revision it makes restores
+// every file byte for byte.  For a first backup (hash mode) and an incremental one (quick
+// mode), with the entries in memory and on disk.
+func TestResumePoint(t *testing.T) {
+	// One LogFunction for the whole test: goroutines a stopped backup leaves behind may still
+	// log, so it is never reassigned while they run.  Errors still panic, as without it.
+	LogFunction = func(level int, logID string, message string) {
+		resumeLog.Lock()
+		if resumeLog.handle != nil {
+			resumeLog.handle(level, logID, message)
+		}
+		resumeLog.Unlock()
+		if level > WARN {
+			panic(Exception{Level: level, LogID: logID, Message: message})
+		}
+	}
+	defer func() { LogFunction = nil }()
+	for _, c := range []struct {
+		name        string
+		incremental bool
+		inMemory    int
+		pruned      bool
+	}{
+		{"first", false, 1024, false},
+		{"incremental", true, 1024, false},
+		{"first-on-disk", false, 0, false},
+		{"incremental-on-disk", true, 0, false},
+		{"incremental-pruned", true, 1024, true},
+	} {
+		t.Run(c.name, func(t *testing.T) { testResumePoint(t, c.incremental, c.inMemory, c.pruned) })
+	}
+	t.Run("interrupted-twice-pruned", testResumeTwicePruned)
+}
+
+type stopBackup struct{}
+
+var resumeLog struct {
+	sync.Mutex
+	handle func(level int, logID string, message string)
+}
+
+// pruned: one of the chunks the stopped backup uploaded is deleted before it resumes, as a
+// prune can do, so the resume point must not be used.
+func testResumePoint(t *testing.T, incremental bool, inMemory int, pruned bool) {
+	setTestingT(t)
+	SetLoggingLevel(INFO)
+	testDir := path.Join(os.TempDir(), "duplicacy_resume_test")
+	os.RemoveAll(testDir)
+	defer os.RemoveAll(testDir)
+	top := testDir + "/repository1"
+	os.MkdirAll(top+"/.duplicacy", 0700)
+	os.MkdirAll(testDir+"/repository2/.duplicacy", 0700)
+
+	storage, err := loadStorage(testDir+"/storage", 1)
+	if err != nil {
+		t.Fatalf("Failed to create storage: %v", err)
+	}
+	cleanStorage(storage)
+	if !ConfigStorage(storage, 16384, 100, 64*1024, 256*1024, 16*1024, "duplicacy", nil, false, "", 0, 0) {
+		t.Fatal("Failed to initialize the storage")
+	}
+	SetDuplicacyPreferencePath(top + "/.duplicacy")
+	manager := CreateBackupManager("host1", storage, testDir, "duplicacy", "", "", false)
+	manager.SetupSnapshotCache("default")
+
+	var files []string
+	if incremental {
+		for i := 0; i < 2; i++ {
+			files = append(files, fmt.Sprintf("old%d", i))
+			createRandomFile(top+"/"+files[i], 1000000)
+		}
+		manager.Backup(top, true, 1, "first", false, false, 0, false, 1024, inMemory)
+		modifyFile(top+"/old0", 0.3)
+	}
+	for i := 0; i < 8; i++ {
+		files = append(files, fmt.Sprintf("new%d", i))
+		createRandomFile(top+"/"+files[len(files)-1], 1000000)
+	}
+
+	// Saved at every chunk; the backup is stopped just after the 40th save.
+	os.Setenv("DUPLICACY_RESUME_INTERVAL", "0")
+	defer os.Unsetenv("DUPLICACY_RESUME_INTERVAL")
+	saves := 0
+	afterResumePointSaved = func() {
+		saves++
+		if saves == 40 {
+			panic(stopBackup{})
+		}
+	}
+	defer func() { afterResumePointSaved = func() {} }()
+	func() {
+		defer func() {
+			r := recover()
+			if _, ok := r.(stopBackup); !ok {
+				panic(fmt.Sprintf("the backup was not stopped at its resume point: %v", r))
+			}
+		}()
+		manager.Backup(top, true, 1, "second", false, false, 0, false, 1024, inMemory)
+	}()
+	afterResumePointSaved = func() {}
+	time.Sleep(2 * time.Second) // uploads already started finish
+
+	cachePath := ""
+	filepath.Walk(top+"/.duplicacy", func(p string, info os.FileInfo, err error) error {
+		if err == nil && info.Name() == "incomplete_chunks" {
+			cachePath = filepath.Dir(p)
+		}
+		return nil
+	})
+	saved := loadIncompleteSnapshot("host1", cachePath)
+	if saved == nil {
+		t.Fatalf("no resume point was saved in %q", cachePath)
+	}
+	// Finished: packed, and every chunk uploaded, which is what the resume point hands on (a
+	// file whose last chunk was still uploading is read again, as it must be).
+	packedThen := map[string]bool{}
+	for _, entry := range saved.ModifiedEntries {
+		if entry.Size > 0 {
+			packedThen[entry.Path] = true
+		}
+	}
+	var finished []string
+	saved.ReadEntries(func(entry *Entry) error {
+		if packedThen[entry.Path] {
+			finished = append(finished, entry.Path)
+		}
+		return nil
+	})
+	saved.CloseOnDiskFile()
+	if len(finished) == 0 || len(finished) == len(saved.ModifiedEntries) {
+		t.Fatalf("the resume point should fall mid-backup: %d of %d files finished", len(finished), len(saved.ModifiedEntries))
+	}
+	if pruned {
+		chunkID := manager.config.GetChunkIDFromHash(saved.UploadedChunkHashes[0])
+		chunkPath, exist, _, err := storage.FindChunk(0, chunkID, false)
+		if err != nil || !exist {
+			t.Fatalf("the first uploaded chunk is not on the storage: %v", err)
+		}
+		if err := os.Remove(path.Join(testDir, "storage", chunkPath)); err != nil {
+			t.Fatal(err)
+		}
+		finished = nil // nothing is resumed, so everything is read again
+	}
+
+	resumed := false
+	packed := map[string]bool{}
+	resumeLog.Lock()
+	resumeLog.handle = func(level int, logID string, message string) {
+		if level > WARN {
+			t.Errorf("%s %s", logID, message)
+		}
+		if logID == "INCOMPLETE_LOAD" && strings.HasPrefix(message, "Previous incomplete backup") {
+			resumed = true
+		}
+		if logID == "INCOMPLETE_DISCARD" {
+			resumed = false
+		}
+		if logID == "PACK_START" {
+			packed[strings.TrimPrefix(message, "Packing ")] = true
+		}
+	}
+	resumeLog.Unlock()
+	manager.Backup(top, true, 1, "third", false, false, 0, false, 1024, inMemory)
+	resumeLog.Lock()
+	resumeLog.handle = nil
+	resumeLog.Unlock()
+
+	if resumed != !pruned {
+		t.Errorf("resumed %v, with a chunk pruned %v", resumed, pruned)
+	}
+	for _, f := range finished {
+		if packed[f] {
+			t.Errorf("%s, finished before the stop, was read again", f)
+		}
+	}
+	for _, f := range []string{"incomplete_snapshot", "incomplete_chunks", "incomplete_files"} {
+		if _, err := os.Stat(path.Join(cachePath, f)); err == nil {
+			t.Errorf("%s was left after the backup completed", f)
+		}
+	}
+
+	SetDuplicacyPreferencePath(testDir + "/repository2/.duplicacy")
+	revision := 1
+	if incremental {
+		revision = 2
+	}
+	failed := manager.Restore(testDir+"/repository2", revision, true, false, 1, true, false, false, false, nil, false)
+	assertRestoreFailures(t, failed, 0)
+	for _, f := range files {
+		if getFileHash(top+"/"+f) != getFileHash(testDir+"/repository2/"+f) {
+			t.Errorf("%s did not restore byte for byte", f)
+		}
+	}
+}
