+// SaveResumePoint saves where the backup is, as SaveIncompleteSnapshot does when the backup
+// fails, but without ending it, so a backup that is killed or loses power can resume from
+// here.  The entries never change during the upload (only the uploaded chunks and the sizes
+// of packed files do), so 'incomplete_snapshot' is written once per backup, and
+// 'incomplete_chunks' is replaced atomically each time.  A crash at any moment leaves the
+// previous resume point or this one: a pair from two different backups fails the token
+// check and is discarded.  It must be called from the goroutine that packs files, the one
+// that writes ModifiedEntries.
+func (entryList *EntryList) SaveResumePoint() {
+	entryList.uploadedChunkLock.Lock()
+	defer entryList.uploadedChunkLock.Unlock()
+
+	if !entryList.resumeEntriesSaved {
+		err := writeFileAtomically(path.Join(entryList.cachePath, "incomplete_snapshot"), entryList.writeEntries)
+		if err != nil {
+			LOG_WARN("RESUME_SAVE", "Failed to save the entries to resume from: %v", err)
+			return
+		}
+		entryList.resumeEntriesSaved = true
+	}
+
+	entryList.Checksum = entryList.CalculateChecksum()
+	err := writeFileAtomically(path.Join(entryList.cachePath, "incomplete_chunks"), func(w io.Writer) error {
+		return msgpack.NewEncoder(w).Encode(entryList)
+	})
+	if err != nil {
+		LOG_WARN("RESUME_SAVE", "Failed to save the resume point: %v", err)
+		return
+	}
+	LOG_DEBUG("RESUME_SAVE", "Resume point saved with %d chunks uploaded", len(entryList.UploadedChunkHashes))
+	afterResumePointSaved()
+}
+
+// writeEntries writes the token and the entries, as the on-disk entry list holds them.
+func (entryList *EntryList) writeEntries(w io.Writer) error {
+	if entryList.onDiskFile != nil {
+		// The on-disk list is complete by now (entries are all added before the upload
+		// starts) and its encoder does not buffer, so its file is copied as it is.
+		file, err := os.Open(path.Join(entryList.cachePath, "incomplete_files"))
+		if err != nil {
+			return err
+		}
+		defer file.Close()
+		_, err = io.Copy(w, file)
+		return err
+	}
+	encoder := msgpack.NewEncoder(w)
+	if err := encoder.EncodeString(entryList.Token); err != nil {
+		return err
+	}
+	for _, entry := range entryList.entries {
+		if err := entry.EncodeWithHash(encoder); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// writeFileAtomically writes a file aside, syncs it, renames it into place and syncs the
+// directory.  The file aside has a random name of its own, never one that could already
+// exist: the cache is inside the repository, and a link planted at a fixed name would be
+// written through.
+func writeFileAtomically(filePath string, write func(io.Writer) error) error {
+	file, err := ioutil.TempFile(path.Dir(filePath), "."+path.Base(filePath)+".*.tmp")
+	if err != nil {
+		return err
+	}
+	temporary := file.Name()
+	err = write(file)
+	if err == nil {
+		err = file.Sync()
+	}
+	if closeErr := file.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		os.Remove(temporary)
+		return err
+	}
+	if err = os.Rename(temporary, filePath); err != nil {
+		return err
+	}
+	// The rename itself survives a power loss only once the directory is synced too.
+	if directory, err := os.Open(path.Dir(filePath)); err == nil {
+		directory.Sync()
+		directory.Close()
+	}
+	return nil
+}
