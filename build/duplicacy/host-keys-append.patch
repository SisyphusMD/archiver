SFTP: append host keys to known_hosts instead of writing at the end of what was read

Why: Archiver points every repository's known_hosts at one shared record on the logs volume.
Duplicacy wrote a new host key at the offset where its read ended, so two processes meeting new
servers at once overwrote each other's key; appending keeps both.
Test: TestHostKeysAppendConcurrently
Upstream: not submitted (upstreaming deferred, 2026-10-11).

--- a/src/duplicacy_storage.go
+++ b/src/duplicacy_storage.go
@@ -168,7 +168,9 @@
 		return fmt.Errorf("Can't verify SSH host since the preference path is not set")
 	}
 	hostFile := path.Join(preferencePath, "known_hosts")
-	file, err := os.OpenFile(hostFile, os.O_RDWR|os.O_CREATE, 0600)
+	// Appending, a record shared by processes that each meet a new server at once keeps
+	// every key: a write at the offset its read ended at would overwrite the other's.
+	file, err := os.OpenFile(hostFile, os.O_RDWR|os.O_CREATE|os.O_APPEND, 0600)
 	if err != nil {
 		return err
 	}
--- /dev/null
+++ b/src/duplicacy_storage_hostkey_test.go
@@ -0,0 +1,59 @@
+package duplicacy
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"fmt"
+	"io/ioutil"
+	"net"
+	"path"
+	"strings"
+	"sync"
+	"testing"
+
+	"golang.org/x/crypto/ssh"
+)
+
+// Processes sharing one known_hosts file that meet new servers at the same time record every
+// server's key, none overwriting another's.
+func TestHostKeysAppendConcurrently(t *testing.T) {
+	saved := preferencePath
+	defer func() { preferencePath = saved }()
+	preferencePath = t.TempDir()
+
+	const servers = 64
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	for i := 0; i < servers; i++ {
+		pub, _, err := ed25519.GenerateKey(rand.Reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		key, err := ssh.NewPublicKey(pub)
+		if err != nil {
+			t.Fatal(err)
+		}
+		remote := &net.TCPAddr{IP: net.IPv4(10, 0, byte(i/250), byte(i%250+1)), Port: 2222}
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			if err := checkHostKey("", remote, key); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+
+	content, err := ioutil.ReadFile(path.Join(preferencePath, "known_hosts"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < servers; i++ {
+		host := fmt.Sprintf("10.0.%d.%d:2222 ", i/250, i%250+1)
+		if strings.Count(string(content), "\n"+host)+map[bool]int{true: 1}[strings.HasPrefix(string(content), host)] != 1 {
+			t.Errorf("%s recorded other than once:\n%s", host, content)
+		}
+	}
+}
