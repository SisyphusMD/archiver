+// linkedAncestor returns the first directory between top and the entry at relative path p
+// that is a symbolic link, or "" when there is none.  top itself may be a link: it is where
+// the restore was asked to go.
+func linkedAncestor(top string, p string) string {
+	dir := top
+	// A directory entry's path ends in a slash; the entry itself is not its own ancestor.
+	parts := strings.Split(strings.TrimSuffix(p, "/"), "/")
+	for _, part := range parts[:len(parts)-1] {
+		if part == "" {
+			continue
+		}
+		dir = joinPath(dir, part)
+		stat, err := os.Lstat(dir)
+		if err != nil {
+			return ""
+		}
+		if stat.Mode()&os.ModeSymlink != 0 {
+			return dir
+		}
+	}
+	return ""
+}
+
+// isRegularFile reports whether path is a regular file, not a link to one, below no link.
+func isRegularFile(path string) bool {
+	stat, err := os.Lstat(path)
+	if err != nil || !stat.Mode().IsRegular() {
+		return false
+	}
+	real, err := filepath.EvalSymlinks(path)
+	return err == nil && real == filepath.Clean(path)
+}
