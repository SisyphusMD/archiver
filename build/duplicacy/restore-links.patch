+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"os"
+	"path"
+	"sync"
+	"testing"
+)
+
+// A restore never writes through a symbolic link in its destination: one where the snapshot
+// has a directory or a file is refused without -overwrite and replaced with it, and a file
+// below a linked directory outside the restored paths is not restored.  What the links point
+// to is never touched.
+func TestRestoreNeverFollowsLinks(t *testing.T) {
+	var mu sync.Mutex
+	logged := map[string]bool{}
+	LogFunction = func(level int, logID string, message string) {
+		mu.Lock()
+		logged[logID] = true
+		mu.Unlock()
+		if level > WARN {
+			panic(Exception{Level: level, LogID: logID, Message: message})
+		}
+	}
+	defer func() { LogFunction = nil }()
+	setTestingT(t)
+	SetLoggingLevel(INFO)
+
+	testDir := path.Join(os.TempDir(), "duplicacy_restorelinks_test")
+	os.RemoveAll(testDir)
+	defer os.RemoveAll(testDir)
+	top := testDir + "/repository1"
+	os.MkdirAll(top+"/.duplicacy", 0700)
+	os.MkdirAll(top+"/d", 0700)
+	os.WriteFile(top+"/d/f", []byte("restored f"), 0600)
+	os.MkdirAll(top+"/d/sub", 0700)
+	os.WriteFile(top+"/d/sub/h", []byte("restored h"), 0600)
+	os.Symlink("f", top+"/d/ln")
+	os.MkdirAll(top+"/e", 0700)
+	os.MkdirAll(top+"/d/empty", 0700)
+	os.WriteFile(top+"/g", []byte("restored g"), 0600)
+	storage, err := loadStorage(testDir+"/storage", 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cleanStorage(storage)
+	if !ConfigStorage(storage, 16384, 100, 64*1024, 256*1024, 16*1024, "duplicacy", nil, false, "", 0, 0) {
+		t.Fatal("Failed to initialize the storage")
+	}
+	SetDuplicacyPreferencePath(top + "/.duplicacy")
+	manager := CreateBackupManager("host1", storage, testDir, "duplicacy", "", "", false)
+	manager.SetupSnapshotCache("default")
+	manager.Backup(top, true, 1, "first", false, false, 0, false, 1024, 1024)
+
+	// What the links point to: a directory and a file outside any destination.
+	outside := testDir + "/outside"
+	os.MkdirAll(outside+"/dir", 0700)
+	os.WriteFile(outside+"/file", []byte("untouched"), 0600)
+	untouched := func() {
+		t.Helper()
+		if b, _ := os.ReadFile(outside + "/file"); string(b) != "untouched" {
+			t.Errorf("the file a link pointed to was written: %q", b)
+		}
+		if entries, _ := os.ReadDir(outside + "/dir"); len(entries) != 0 {
+			t.Errorf("a file was restored into the directory a link pointed to")
+		}
+	}
+	destination := func(name string) string {
+		dir := testDir + "/" + name
+		os.MkdirAll(dir+"/.duplicacy", 0700)
+		os.Symlink(outside+"/dir", dir+"/d")
+		os.Symlink(outside+"/file", dir+"/g")
+		SetDuplicacyPreferencePath(dir + "/.duplicacy")
+		return dir
+	}
+	quick := false
+	restore := func(dir string, overwrite bool, patterns []string, deleteMode ...bool) (failed int, refused bool) {
+		defer func() {
+			if r := recover(); r != nil {
+				if _, ok := r.(Exception); !ok {
+					panic(r)
+				}
+				refused = true
+			}
+		}()
+		return manager.Restore(dir, 1, true, quick, 1, overwrite, len(deleteMode) > 0, false, false, patterns, true), false
+	}
+
+	if _, refused := restore(destination("refused"), false, nil); !refused || !logged["RESTORE_LINKDIR"] {
+		t.Error("a linked directory was not refused without -overwrite")
+	}
+	untouched()
+
+	dir := destination("replaced")
+	if failed, refused := restore(dir, true, nil); refused || failed != 0 {
+		t.Fatalf("restore with -overwrite: refused %v, %d failed", refused, failed)
+	}
+	for name, want := range map[string]string{"d/f": "restored f", "d/sub/h": "restored h", "g": "restored g"} {
+		stat, err := os.Lstat(dir + "/" + name)
+		if err != nil || stat.Mode()&os.ModeSymlink != 0 {
+			t.Errorf("%s is still a link or missing: %v", name, err)
+		}
+		if b, _ := os.ReadFile(dir + "/" + name); string(b) != want {
+			t.Errorf("%s restored %q", name, b)
+		}
+	}
+	if stat, _ := os.Lstat(dir + "/d"); stat == nil || !stat.IsDir() {
+		t.Error("the linked directory was not replaced by a directory")
+	}
+	untouched()
+
+	// With -delete too: links replaced by an empty directory the snapshot has are not then
+	// deleted as extra local entries. A link below the top, and a relative one, are listed
+	// as links (one at the top to an absolute path is followed by the listing).
+	dir = testDir + "/deleting"
+	os.MkdirAll(dir+"/.duplicacy", 0700)
+	os.MkdirAll(dir+"/d", 0700)
+	os.MkdirAll(outside+"/dir2", 0700)
+	os.Symlink(outside+"/dir2", dir+"/d/empty")
+	os.Symlink("../outside/dir2", dir+"/e")
+	SetDuplicacyPreferencePath(dir + "/.duplicacy")
+	if failed, refused := restore(dir, true, nil, true); refused || failed != 0 {
+		t.Fatalf("restore with -overwrite -delete: refused %v, %d failed", refused, failed)
+	}
+	for _, name := range []string{"d/empty", "e"} {
+		if stat, err := os.Lstat(dir + "/" + name); err != nil || !stat.IsDir() {
+			t.Errorf("the empty directory %s that replaced a link was deleted or is not one: %v", name, err)
+		}
+	}
+	if entries, _ := os.ReadDir(outside + "/dir2"); len(entries) != 0 {
+		t.Error("something was restored into a directory a link pointed to")
+	}
+	untouched()
+
+	// In quick mode a top-level link to a file the size and time of the snapshot's is still
+	// refused, and replaced when overwriting.
+	quick = true
+	if err := os.WriteFile(outside+"/same", []byte("restored g"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	stat, _ := os.Stat(top + "/g")
+	os.Chtimes(outside+"/same", stat.ModTime(), stat.ModTime())
+	sameDestination := func(name string) string {
+		dir := testDir + "/" + name
+		os.MkdirAll(dir+"/.duplicacy", 0700)
+		os.Symlink(outside+"/same", dir+"/g")
+		SetDuplicacyPreferencePath(dir + "/.duplicacy")
+		return dir
+	}
+	if _, refused := restore(sameDestination("quick-refused"), false, []string{"+g"}); !refused {
+		t.Error("quick mode skipped a linked file as unchanged instead of refusing it")
+	}
+	dir = sameDestination("quick-replaced")
+	if failed, refused := restore(dir, true, []string{"+g"}); refused || failed != 0 {
+		t.Fatalf("quick restore with -overwrite: refused %v, %d failed", refused, failed)
+	}
+	if stat, _ := os.Lstat(dir + "/g"); stat == nil || !stat.Mode().IsRegular() {
+		t.Error("quick mode left the link in place")
+	}
+	// ... and a top-level link to a directory holding what looks like the snapshot's files
+	// is replaced, and those files are restored into the new directory, not skipped.
+	os.MkdirAll(outside+"/look", 0700)
+	os.WriteFile(outside+"/look/f", []byte("restored f"), 0600)
+	fstat, _ := os.Stat(top + "/d/f")
+	os.Chtimes(outside+"/look/f", fstat.ModTime(), fstat.ModTime())
+	dir = testDir + "/quick-dir"
+	os.MkdirAll(dir+"/.duplicacy", 0700)
+	os.Symlink(outside+"/look", dir+"/d")
+	SetDuplicacyPreferencePath(dir + "/.duplicacy")
+	if failed, refused := restore(dir, true, nil); refused || failed != 0 {
+		t.Fatalf("quick restore over a linked directory: refused %v, %d failed", refused, failed)
+	}
+	if b, err := os.ReadFile(dir + "/d/f"); err != nil || string(b) != "restored f" {
+		t.Errorf("d/f was skipped instead of restored into the directory that replaced the link: %v", err)
+	}
+	quick = false
+	untouched()
+
+	// Only paths below d are restored: the directory entry d is not, so its link stays, and
+	// nothing below it (a file, a directory, a link, a file in that directory) is created
+	// through it.
+	dir = destination("partial")
+	if failed, refused := restore(dir, true, []string{"+d/f", "+d/ln", "+d/sub/", "+d/sub/h"}); refused || failed != 4 {
+		t.Errorf("entries below a linked directory: refused %v, %d failed (want 4)", refused, failed)
+	}
+	untouched()
+	if _, err := os.Lstat(outside + "/dir/ln"); err == nil {
+		t.Error("a link was created through the linked directory")
+	}
+}
