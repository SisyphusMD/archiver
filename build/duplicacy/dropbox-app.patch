+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"golang.org/x/oauth2"
+)
+
+// A token Dropbox rejects before its expiry is replaced on the next request.
+func TestDropboxAppTokensReplaceRejected(t *testing.T) {
+	var issued int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/oauth2/token":
+			r.ParseForm()
+			if r.Form.Get("grant_type") != "refresh_token" || r.Form.Get("refresh_token") != "refresh" {
+				http.Error(w, "bad request", http.StatusBadRequest)
+				return
+			}
+			n := atomic.AddInt32(&issued, 1)
+			w.Header().Set("Content-Type", "application/json")
+			fmt.Fprintf(w, `{"access_token":"access-%d","token_type":"bearer","expires_in":14400}`, n)
+		case "/2/users/get_current_account":
+			if r.Header.Get("Authorization") != "Bearer access-2" {
+				http.Error(w, "expired", http.StatusUnauthorized)
+				return
+			}
+			w.Write([]byte(`{}`))
+		}
+	}))
+	defer server.Close()
+
+	tokens := &appTokens{
+		config:       &oauth2.Config{ClientID: "key", ClientSecret: "secret", Endpoint: oauth2.Endpoint{TokenURL: server.URL + "/oauth2/token"}},
+		refreshToken: "refresh",
+	}
+	client := &http.Client{Transport: tokens}
+	call := func() int {
+		response, err := client.Post(server.URL+"/2/users/get_current_account", "application/json", nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		response.Body.Close()
+		return response.StatusCode
+	}
+	if status := call(); status != http.StatusUnauthorized {
+		t.Fatalf("first call: %d, want 401 for the rejected token", status)
+	}
+	if status := call(); status != http.StatusOK {
+		t.Fatalf("retry: %d, want 200 with a fresh token", status)
+	}
+	if issued != 2 {
+		t.Errorf("%d tokens issued, want 2", issued)
+	}
+}
