+// appTokens authorizes requests with access tokens from the user's own Dropbox app. A token
+// Dropbox rejects is dropped, so the client's retry of a 401 gets a fresh one.
+type appTokens struct {
+	lock         sync.Mutex
+	config       *oauth2.Config
+	refreshToken string
+	token        *oauth2.Token
+}
+
+func (tokens *appTokens) current() (string, error) {
+	tokens.lock.Lock()
+	defer tokens.lock.Unlock()
+	if !tokens.token.Valid() {
+		token, err := tokens.config.TokenSource(context.Background(), &oauth2.Token{RefreshToken: tokens.refreshToken}).Token()
+		if err != nil {
+			return "", fmt.Errorf("failed to refresh the access token with the Dropbox app: %v", err)
+		}
+		tokens.token = token
+	}
+	return tokens.token.AccessToken, nil
+}
+
+func (tokens *appTokens) RoundTrip(request *http.Request) (*http.Response, error) {
+	accessToken, err := tokens.current()
+	if err != nil {
+		return nil, err
+	}
+	request = request.Clone(request.Context())
+	request.Header.Set("Authorization", "Bearer "+accessToken)
+	response, err := http.DefaultTransport.RoundTrip(request)
+	if err == nil && response.StatusCode == http.StatusUnauthorized {
+		tokens.lock.Lock()
+		if tokens.token != nil && tokens.token.AccessToken == accessToken {
+			tokens.token = nil
+		}
+		tokens.lock.Unlock()
+	}
+	return response, err
+}
