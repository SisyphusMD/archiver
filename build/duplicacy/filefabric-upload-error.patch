+package duplicacy
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+// An upload the server keeps refusing, or cannot be sent at all, fails with an error once the retries run out.
+func TestFileFabricUploadFailsAfterRetries(t *testing.T) {
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte(`<response><status>error</status><statusmessage>quota exceeded</statusmessage></response>`))
+	}))
+	defer server.Close()
+
+	storage := &FileFabricStorage{
+		endpoint:       strings.TrimPrefix(server.URL, "https://"),
+		accessToken:    "token",
+		storageDirID:   "root",
+		client:         server.Client(),
+		threads:        1,
+		directoryCache: map[string]string{},
+	}
+
+	err := storage.UploadFile(0, "config", []byte("content"))
+	if err == nil || !strings.Contains(err.Error(), "quota exceeded") {
+		t.Fatalf("refused upload: got %v, want an error naming the server's message", err)
+	}
+
+	server.Close()
+	if err := storage.UploadFile(0, "config", []byte("content")); err == nil {
+		t.Fatal("unreachable server: got nil, want an error")
+	}
+}
