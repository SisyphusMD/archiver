+
+// A connection reset or timed out mid-download says nothing about the chunk, so it is retried with
+// a backoff instead of failing a restore that may be a day into its download.
+const MaxNetworkDownloadAttempts = 8
+
+func isTransientNetworkError(err error) bool {
+	if err == nil {
+		return false
+	}
+	if errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, syscall.ECONNRESET) ||
+		errors.Is(err, syscall.ECONNABORTED) || errors.Is(err, syscall.EPIPE) || errors.Is(err, syscall.ETIMEDOUT) {
+		return true
+	}
+	var netErr net.Error
+	return errors.As(err, &netErr) && netErr.Timeout()
+}
+
+var networkRetryBase = 2 * time.Second
+
+// networkRetryDelay is 2s, 4s, 8s ... capped at a minute: about four minutes over all attempts.
+func networkRetryDelay(attempt int) time.Duration {
+	delay := networkRetryBase << uint(attempt)
+	if delay > time.Minute || delay <= 0 {
+		return time.Minute
+	}
+	return delay
+}
