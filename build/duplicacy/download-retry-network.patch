+package duplicacy
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// cutOffStorage fails the first `failures` downloads the way a dropped connection does.
+type cutOffStorage struct {
+	Storage
+	failures int
+	err      error
+	calls    int
+}
+
+func (storage *cutOffStorage) DownloadFile(threadIndex int, filePath string, chunk *Chunk) error {
+	storage.calls++
+	if storage.calls <= storage.failures {
+		return storage.err
+	}
+	return storage.Storage.DownloadFile(threadIndex, filePath, chunk)
+}
+
+// A chunk download cut off by the network is retried until it arrives, a bounded number of times;
+// an error that says something about the chunk is not retried.
+func TestChunkDownloadRetriesNetworkErrors(t *testing.T) {
+	defer func(base time.Duration) { networkRetryBase = base }(networkRetryBase)
+	networkRetryBase = time.Millisecond
+	setTestingT(t)
+
+	dir := t.TempDir()
+	fileStorage, err := CreateFileStorage(dir, false, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := fileStorage.CreateDirectory(0, "chunks"); err != nil {
+		t.Fatal(err)
+	}
+	config := CreateConfig()
+	config.chunkPool = make(chan *Chunk, 16)
+	content := bytes.Repeat([]byte("archiver"), 4096)
+	chunk := CreateChunk(config, true)
+	chunk.Reset(true)
+	chunk.Write(content)
+	uploader := CreateChunkOperator(config, fileStorage, nil, false, false, 1, false)
+	uploader.UploadCompletionFunc = func(*Chunk, int, bool, int, int) {}
+	uploader.Upload(chunk, 0, false)
+	uploader.WaitForCompletion()
+	uploader.Stop()
+
+	reset := &net.OpError{Op: "read", Net: "tcp", Err: os.NewSyscallError("read", syscall.ECONNRESET)}
+	for _, c := range []struct {
+		name      string
+		err       error
+		failures  int
+		delivered bool
+		calls     int
+	}{
+		{"reset by peer", reset, 4, true, 5},
+		{"timeout", &net.OpError{Op: "read", Net: "tcp", Err: os.NewSyscallError("read", syscall.ETIMEDOUT)}, 1, true, 2},
+		{"unexpected EOF", io.ErrUnexpectedEOF, 2, true, 3},
+		{"never comes back", reset, 1000, false, MaxNetworkDownloadAttempts + 1},
+		{"not a network error", errors.New("403 forbidden"), 1, false, 1},
+	} {
+		storage := &cutOffStorage{Storage: fileStorage, failures: c.failures, err: c.err}
+		operator := CreateChunkOperator(config, storage, nil, false, false, 1, true)
+		downloaded := operator.Download(chunk.GetHash(), 0, false)
+		operator.Stop()
+		delivered := !downloaded.isBroken && bytes.Equal(downloaded.GetBytes(), content)
+		if delivered != c.delivered || storage.calls != c.calls {
+			t.Errorf("%s: delivered %v after %d downloads, want %v after %d", c.name, delivered, storage.calls, c.delivered, c.calls)
+		}
+	}
+}
